{
  "$schema": "HospiCore Design Tokens v1",
  "name": "HospiCore DS",
  "version": "1.0.0",
  "date": "2026-10-09",
  "note": "Tokens partagés entre Windows (WinUI 3 / Fluent), Android (Material You / Compose) et Web (React PWA). Source de vérité pour le design system. Chaque plateforme mappe ces tokens vers ses primitives natives.",
  "color": {
    "semantic": {
      "danger": { "value": "#D13438", "usage": "Erreur, alerte critique (allergie, résultat critique) — toujours + icône + texte" },
      "warning": { "value": "#CA5010", "usage": "Avertissement (péremption proche, valeur anormale)" },
      "success": { "value": "#107C10", "usage": "Succès, valeur normale, confirmation" },
      "info": { "value": "#0078D4", "usage": "Information, accent principal (équivalent accent Fluent/Material)" },
      "neutral": { "value": "#605E5C", "usage": "Texte secondaire" }
    },
    "surface": {
      "canvas": { "value": "#F3F3F3", "usage": "Fond application (clair)" },
      "canvasDark": { "value": "#1F1F1F", "usage": "Fond application (sombre)" },
      "card": { "value": "#FFFFFF", "usage": "Carte/panneau (clair)" },
      "cardDark": { "value": "#2B2B2B", "usage": "Carte/panneau (sombre)" }
    },
    "contrast": {
      "textOnLight": { "value": "#242424", "ratio": "15.9:1 (AAA)" },
      "textOnDark": { "value": "#FFFFFF", "ratio": "15.9:1 (AAA)" }
    },
    "rule": "L'information clinique n'est JAMAIS véhiculée par la couleur seule (WCAG 2.2 — 1.4.1). Toujours couleur + icône + texte."
  },
  "spacing": {
    "grid": 4,
    "scale": { "xs": 4, "s": 8, "m": 16, "l": 24, "xl": 32, "xxl": 48 }
  },
  "radius": {
    "small": 4,
    "medium": 8,
    "large": 12,
    "card": 8,
    "pill": 999,
    "note": "Windows (Fluent) : 4-8 px. Android (Material 3) : 12-28 px (formes expressives). Web : 8 px."
  },
  "typography": {
    "family": {
      "windows": "Segoe UI Variable",
      "android": "Roboto / Google Sans (Material 3)",
      "web": "Inter, 'Segoe UI', system-ui, sans-serif"
    },
    "scale": {
      "caption": { "size": 12, "weight": 400 },
      "body": { "size": 14, "weight": 400 },
      "bodyStrong": { "size": 14, "weight": 600 },
      "subtitle": { "size": 20, "weight": 600 },
      "title": { "size": 28, "weight": 600 },
      "display": { "size": 40, "weight": 600 }
    },
    "lineHeight": { "body": 1.5, "heading": 1.2 }
  },
  "motion": {
    "duration": { "fast": 150, "normal": 250, "slow": 350 },
    "easing": { "standard": "cubic-bezier(0.4, 0, 0.2, 1)", "emphasized": "cubic-bezier(0.2, 0, 0, 1)" },
    "rule": "Animations implicites uniquement ; respecter 'Réduire les animations' (Windows) / 'Remove animations' (Android)."
  },
  "iconography": {
    "windows": { "set": "Fluent System Icons", "sizes": [16, 20, 24, 32], "style": "regular (outline), filled si sélectionné" },
    "android": { "set": "Material Symbols (Rounded)", "sizes": [20, 24], "style": "variable (FILL/GRAD/wght)" },
    "web": { "set": "Material Symbols (cohérent Android) ou Fluent (cohérent Windows)", "sizes": [16, 20, 24] }
  },
  "elevation": {
    "card": "ombre légère (Windows : ombre subtile ; Android : 1-2 dp ; Web : 0 1px 3px rgba(0,0,0,.12))",
    "dialog": "ombre prononcée + surface élevée"
  },
  "accessibility": {
    "minContrastText": 4.5,
    "minContrastLargeText": 3.0,
    "minContrastUI": 3.0,
    "minTouchTarget": 44,
    "focusRing": "2 px, couleur info, jamais supprimé"
  },
  "platformMapping": {
    "windows": "docs/06-direction-ui-ux-windows-11-fluent.md",
    "android": "docs/07-direction-ui-ux-android-material-you.md",
    "web": "docs/08-portail-patient-web-pwa.md"
  }
}
